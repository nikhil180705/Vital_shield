# LM Studio Configuration
# Environment variables for Health Risk System

# LM Studio server base URL (default: local)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Model name as loaded in LM Studio
LM_STUDIO_MODEL=qwen2.5-3b-instruct

# Request timeout in seconds
LM_STUDIO_TIMEOUT=180

# Maximum tokens in LLM response
LM_STUDIO_MAX_TOKENS=1024

# LLM temperature (lower = more deterministic)
LM_STUDIO_TEMPERATURE=0.2

# Logging
LOG_LEVEL=INFO
LOG_FILE=health_risk_system.log
